{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Template Selection",
  "description": "Agent picks actions and warnings by index from retrieved wiki articles.",
  "type": "object",
  "properties": {
    "risk_level": {
      "type": "string",
      "enum": ["NORMAL", "WATCH", "PREVENTIVE_ACTION", "ESCALATE"]
    },
    "confidence": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "selected_action_indices": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 49 },
      "minItems": 0,
      "maxItems": 5
    },
    "selected_warning_indices": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 49 },
      "maxItems": 3
    },
    "contextualization": {
      "type": "string",
      "description": "Farmer-friendly Hindi/English explanation tying evidence to recommendation",
      "maxLength": 800
    },
    "memory_reference": {
      "type": "string",
      "description": "Optional reference to this farmer's previous observation pattern",
      "maxLength": 200
    },
    "should_escalate_to_extension_worker": {
      "type": "boolean"
    },
    "escalation_reason": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": ["risk_level", "confidence", "selected_action_indices", "contextualization"],
  "additionalProperties": false
}
