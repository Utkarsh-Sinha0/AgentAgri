# AgriMesh V4.0 — Environment Configuration
# Copy this to .env and fill in values

# ─── Ollama ───────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_FALLBACK_MODEL=gemma4:e2b
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_BATCH=512
OLLAMA_KEEP_ALIVE=-1
# Grammar-constrained decoding (set to '1' to enable)
USE_GRAMMAR_DECODING=1

# ─── Database ─────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/agrimesh.db
# For production: postgresql+asyncpg://user:pass@localhost:5432/agrimesh

# ─── Runtime / Security ───────────────────
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
AGRIMESH_REQUIRE_API_KEY=false
# Required when APP_ENV=production or AGRIMESH_REQUIRE_API_KEY=true. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AGRIMESH_API_KEY=
MAX_REQUEST_BYTES=2000000

# ─── Retrieval ────────────────────────────
BGE_M3_MODEL=BAAI/bge-m3
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_TOP_K=10
RERANKER_TOP_K=3

# ─── Telegram ─────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── MCP Servers ─────────────────────────
MCP_WEATHER_PORT=9001
MCP_MANDI_PORT=9002
MCP_SCHEME_PORT=9003
MCP_FINANCE_PORT=9004

# ─── Feature Flags ────────────────────────
USE_GEMMA_AUDIO=false
ENABLE_VOICE_STT=false
ENABLE_SMS=false
ENABLE_BHOJPURI=false

# ─── Paths ────────────────────────────────
DATA_DIR=./data
SEED_DIR=./data/seed
WIKI_DIR=./wiki/articles
EVAL_DIR=./evals

# ─── Logging ──────────────────────────────
LOG_LEVEL=INFO
